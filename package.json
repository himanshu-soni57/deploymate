{
  "name": "deploypilot",
  "version": "0.2.0",
  "description": "Trigger, monitor, and audit GitHub Actions deployments from your terminal.",
  "author": "Himanshu Soni",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/himanshu-soni57/deploymate#readme",
  "bugs": {
    "url": "https://github.com/himanshu-soni57/deploymate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himanshu-soni57/deploymate.git"
  },
  "bin": {
    "deploypilot": "dist/index.js",
    "dpp": "dist/index.js"
  },
  "main": "dist/config.js",
  "types": "dist/config.d.ts",
  "exports": {
    ".": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsup",
    "watch": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "keywords": [
    "cli",
    "github-actions",
    "deployment",
    "deploy",
    "git",
    "tags",
    "semver",
    "workflow-dispatch",
    "ci-cd",
    "automation"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "simple-git": "^3.36.0",
    "yaml": "^2.9.0"
  }
}
